{
  "$schema": "https://design-tokens.org/schema",
  "name": "SelectAI Premium Design System",
  "version": "2.0.0",
  "description": "Premium black & white design system inspired by 21st.dev",

  "colors": {
    "core": {
      "background": {
        "value": "#0A0A0A",
        "description": "Primary background - pure pitch black"
      },
      "surface": {
        "value": "#111111",
        "description": "Elevated surface color for cards, sidebars"
      },
      "surfaceHover": {
        "value": "#1A1A1A",
        "description": "Surface hover state"
      },
      "border": {
        "value": "rgba(255, 255, 255, 0.05)",
        "description": "Subtle borders"
      },
      "borderHover": {
        "value": "rgba(255, 255, 255, 0.10)",
        "description": "Hovered border state"
      }
    },
    "text": {
      "primary": {
        "value": "#FFFFFF",
        "description": "Primary text - pure white"
      },
      "secondary": {
        "value": "#E5E5E5",
        "description": "Secondary text"
      },
      "muted": {
        "value": "#A1A1A1",
        "description": "Muted/placeholder text"
      },
      "disabled": {
        "value": "#6B6B6B",
        "description": "Disabled text"
      }
    },
    "badges": {
      "free": {
        "background": "rgba(52, 211, 153, 0.15)",
        "text": "#34D399",
        "description": "Free tier badge"
      },
      "paid": {
        "background": "rgba(239, 68, 68, 0.15)",
        "text": "#EF4444",
        "description": "Paid tier badge"
      },
      "featured": {
        "background": "rgba(251, 191, 36, 0.15)",
        "text": "#FBBF24",
        "description": "Featured item badge"
      },
      "verified": {
        "background": "rgba(59, 130, 246, 0.15)",
        "text": "#3B82F6",
        "description": "Verified badge"
      },
      "category": {
        "background": "rgba(255, 255, 255, 0.06)",
        "text": "#FFFFFF",
        "description": "Category badge - monochrome"
      },
      "freemium": {
        "background": "rgba(99, 102, 241, 0.15)",
        "text": "#818CF8",
        "description": "Freemium tier badge"
      },
      "enterprise": {
        "background": "rgba(168, 85, 247, 0.15)",
        "text": "#A855F7",
        "description": "Enterprise tier badge"
      }
    },
    "interactive": {
      "hover": {
        "value": "rgba(255, 255, 255, 0.05)",
        "description": "Hover state background"
      },
      "active": {
        "value": "rgba(255, 255, 255, 0.10)",
        "description": "Active/pressed state"
      },
      "focus": {
        "value": "rgba(255, 255, 255, 0.08)",
        "description": "Focus ring color"
      }
    }
  },

  "shadows": {
    "subtle": {
      "value": "0 0 40px rgba(255, 255, 255, 0.02)",
      "description": "Very subtle white glow"
    },
    "card": {
      "value": "0 4px 14px rgba(0, 0, 0, 0.35)",
      "description": "Default card shadow"
    },
    "cardHover": {
      "value": "0 10px 30px rgba(0, 0, 0, 0.45)",
      "description": "Card shadow on hover"
    },
    "elevated": {
      "value": "0 8px 24px rgba(0, 0, 0, 0.40)",
      "description": "Elevated elements shadow"
    }
  },

  "radii": {
    "sm": {
      "value": "6px",
      "description": "Small radius for buttons, inputs"
    },
    "md": {
      "value": "8px",
      "description": "Medium radius"
    },
    "lg": {
      "value": "12px",
      "description": "Large radius"
    },
    "xl": {
      "value": "16px",
      "description": "Extra large radius for cards"
    },
    "2xl": {
      "value": "20px",
      "description": "Double extra large radius"
    },
    "full": {
      "value": "9999px",
      "description": "Fully rounded (pills)"
    }
  },

  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },

  "typography": {
    "fontFamily": {
      "sans": "Inter, system-ui, -apple-system, sans-serif",
      "mono": "JetBrains Mono, Menlo, Monaco, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "lineHeight": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.625"
    },
    "letterSpacing": {
      "tight": "-0.025em",
      "normal": "0",
      "wide": "0.025em"
    }
  },

  "transitions": {
    "fast": {
      "value": "150ms",
      "description": "Fast micro-interactions"
    },
    "normal": {
      "value": "200ms",
      "description": "Normal transitions"
    },
    "slow": {
      "value": "300ms",
      "description": "Slower, more deliberate transitions"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },

  "effects": {
    "blur": {
      "sm": "4px",
      "md": "6px",
      "lg": "12px"
    },
    "cardGlass": {
      "background": "rgba(255, 255, 255, 0.02)",
      "backdropBlur": "6px",
      "border": "rgba(255, 255, 255, 0.05)"
    }
  },

  "components": {
    "card": {
      "background": "rgba(255, 255, 255, 0.02)",
      "backdropBlur": "6px",
      "border": "rgba(255, 255, 255, 0.05)",
      "borderRadius": "16px",
      "shadow": "0 4px 14px rgba(0, 0, 0, 0.35)",
      "shadowHover": "0 10px 30px rgba(0, 0, 0, 0.45)"
    },
    "button": {
      "primary": {
        "background": "#FFFFFF",
        "text": "#0A0A0A",
        "hover": "#E5E5E5"
      },
      "secondary": {
        "background": "rgba(255, 255, 255, 0.06)",
        "text": "#FFFFFF",
        "hover": "rgba(255, 255, 255, 0.10)"
      },
      "ghost": {
        "background": "transparent",
        "text": "#A1A1A1",
        "hover": "rgba(255, 255, 255, 0.05)"
      }
    },
    "input": {
      "background": "rgba(255, 255, 255, 0.03)",
      "border": "rgba(255, 255, 255, 0.08)",
      "borderFocus": "rgba(255, 255, 255, 0.15)",
      "text": "#FFFFFF",
      "placeholder": "#6B6B6B"
    },
    "table": {
      "headerBackground": "#111111",
      "rowBackground": "transparent",
      "rowHover": "rgba(255, 255, 255, 0.05)",
      "border": "rgba(255, 255, 255, 0.05)"
    },
    "sidebar": {
      "background": "#0A0A0A",
      "itemHover": "rgba(255, 255, 255, 0.05)",
      "itemActive": "rgba(255, 255, 255, 0.08)",
      "iconColor": "#6B6B6B",
      "iconColorActive": "#FFFFFF"
    }
  }
}
